---
const { href, variant = "primary" } = Astro.props;
---

<!-- Propósito: ofrecer un enlace reutilizable con variantes de marca. -->
<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-full px-6 py-3 font-medium transition-colors",
    variant === "primary"
      ? "bg-lime text-ink"
      : "border border-bone text-bone",
  ]}
>
  <slot />
</a>
