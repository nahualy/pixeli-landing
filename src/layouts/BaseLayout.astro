---
import "../styles/global.css";
import "../styles/fonts.css";

const { title, description } = Astro.props;
const siteOrigin = Astro.site ? Astro.site.origin : undefined;
const canonicalURL = siteOrigin
  ? new URL(Astro.url.pathname, siteOrigin).href
  : Astro.url.pathname;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Pixeli",
  description,
  ...(siteOrigin ? { url: siteOrigin } : {}),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#18181B" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/CabinetGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Switzer-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <!-- Propósito: compartir la estructura HTML y metadata del sitio. -->
    <slot />
  </body>
</html>
